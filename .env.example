# Railway PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/database

# JWT secret for auth tokens (use a random 64+ character string)
JWT_SECRET=your-random-secret-here

# Resend API key for invitation emails (sign up free at resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# FROM address for emails. For testing without a verified domain, leave unset
# (defaults to "ChargeSmart EV <onboarding@resend.dev>" — only delivers to the
# email address that signed up at resend.com). For production, verify your
# domain in Resend and use e.g. "ChargeSmart EV <noreply@chargesmartev.com>".
EMAIL_FROM=

# Public URL of the deployed app (used to build the "Log In" link in invite emails).
# Leave unset to fall back to the request origin (fine for local dev).
APP_URL=
